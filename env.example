# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored and must NEVER be committed.
#
# These are needed starting in Phase 3 (Supabase backend).
# The EXPO_PUBLIC_ prefix makes a variable available inside the app code.

EXPO_PUBLIC_SUPABASE_URL=your-project-url-here
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
